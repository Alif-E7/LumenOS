# LumenOS Environment Configuration
# Copy to .env and customize for your environment.

# General
LUMENOS_APP_NAME=LumenOS
LUMENOS_APP_VERSION=0.1.0
LUMENOS_DEBUG=true

# Database (SQLite for local dev, PostgreSQL URL for production)
# LUMENOS_DATABASE_URL=sqlite+aiosqlite:///data/lumenos.db

# Simulation
LUMENOS_DEFAULT_SIM_SEED=42
LUMENOS_SIM_TIME_STEP_SECONDS=60.0

# CORS Origins (comma-separated for production)
# LUMENOS_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# NASA API (optional — app works without it)
# NASA_API_KEY=DEMO_KEY

# Cesium Ion (optional — for 3D globe)
# CESIUM_ION_TOKEN=your_token_here
